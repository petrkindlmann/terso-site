{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/docs/layout,_N_T_/docs/[slug]/layout,_N_T_/docs/[slug]/page,_N_T_/docs/standalone-vs-connected"},"segmentPaths":["/_tree","/_full","/docs/$d$slug/__PAGE__","/docs/$d$slug","/docs","/_index","/_head"]},"html":"<!DOCTYPE html><!--_m4JSEWUYkRXgr6u0A91d--><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/12a43aaab7140da3.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/08127cfdc8ec19e0.js\"/><script src=\"/_next/static/chunks/82abf2d65f5428ae.js\" async=\"\"></script><script src=\"/_next/static/chunks/24fee8b2203ad4c2.js\" async=\"\"></script><script src=\"/_next/static/chunks/38eb66a58ed5ffd7.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-84e81848ca79873f.js\" async=\"\"></script><script src=\"/_next/static/chunks/ff1a16fafef87110.js\" async=\"\"></script><script src=\"/_next/static/chunks/d2be314c3ece3fbe.js\" async=\"\"></script><script src=\"/_next/static/chunks/799da3d0ae0b5b88.js\" async=\"\"></script><link rel=\"preload\" href=\"https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&amp;family=Outfit:wght@400;500;600;700&amp;display=swap\" as=\"style\"/><title>Standalone vs Connected | Terso Docs</title><meta name=\"description\" content=\"Terso documentation -- Standalone vs Connected\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.0b3bf435.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><link href=\"https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&amp;family=Outfit:wght@400;500;600;700&amp;display=swap\" rel=\"stylesheet\"/><script src=\"/_next/static/chunks/a6dad97d9634a72d.js\" noModule=\"\"></script></head><body class=\"antialiased\"><div hidden=\"\"><!--$--><!--/$--></div><div class=\"min-h-screen bg-[#0c0c0f]\"><nav aria-label=\"Main navigation\" class=\"fixed top-0 left-0 right-0 z-50 px-5 py-2.5 sm:px-6 sm:py-3 transition-all duration-300 border-b border-transparent\"><div class=\"max-w-[1400px] mx-auto flex justify-between items-center\"><a href=\"/\" class=\"font-bold text-base tracking-[-0.04em] no-underline text-[#e8e6e3] font-mono\">terso</a><div class=\"flex items-center gap-1.5 sm:gap-4\"><a href=\"/docs\" class=\"text-[13px] font-medium text-[#55555e] no-underline p-2 hover:text-[#8a8a96] transition-colors\">Docs</a><a href=\"https://github.com/petr-kin/terso\" target=\"_blank\" rel=\"noopener\" class=\"text-[13px] font-medium text-[#55555e] no-underline p-2 hover:text-[#8a8a96] transition-colors\">GitHub</a><a href=\"https://www.npmjs.com/package/terso-cli\" target=\"_blank\" rel=\"noopener\" class=\"text-[13px] font-medium text-[#55555e] no-underline p-2 hover:text-[#8a8a96] transition-colors\">npm</a><a href=\"/docs/getting-started\" class=\"hidden sm:flex items-center px-4 py-2 text-[13px] font-semibold rounded-lg bg-indigo-500 text-white no-underline ml-1 hover:bg-indigo-600 transition-colors\">Get started</a></div></div></nav><div class=\"flex pt-14\"><button class=\"lg:hidden fixed bottom-5 right-5 z-50 bg-[#141418] text-[#e8e6e3] border border-[#222228] rounded-full w-12 h-12 flex items-center justify-center shadow-lg\" aria-label=\"Toggle docs navigation\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 5h14M3 10h14M3 15h14\"></path></svg></button><aside class=\"\n          fixed lg:sticky top-0 left-0 z-40\n          w-64 h-screen overflow-y-auto\n          bg-[#0c0c0f] border-r border-[#222228]\n          pt-16 pb-8 px-4\n          transition-transform duration-200 ease-out\n          lg:translate-x-0\n          -translate-x-full\n        \"><div class=\"pt-4\"><div class=\"mb-6\"><p class=\"text-[11px] font-semibold text-[#55555e] uppercase tracking-wider px-3 mb-2 font-mono\">Getting Started</p><a class=\"\n                      block px-3 py-1.5 rounded text-sm no-underline transition-colors\n                      text-[#8a8a96] hover:text-[#e8e6e3] hover:bg-[#141418]\n                    \" href=\"/docs/getting-started\">Getting Started</a><a class=\"\n                      block px-3 py-1.5 rounded text-sm no-underline transition-colors\n                      text-[#8a8a96] hover:text-[#e8e6e3] hover:bg-[#141418]\n                    \" href=\"/docs/cli-reference\">CLI Reference</a></div><div class=\"mb-6\"><p class=\"text-[11px] font-semibold text-[#55555e] uppercase tracking-wider px-3 mb-2 font-mono\">Concepts</p><a class=\"\n                      block px-3 py-1.5 rounded text-sm no-underline transition-colors\n                      text-[#8a8a96] hover:text-[#e8e6e3] hover:bg-[#141418]\n                    \" href=\"/docs/terso-format\">.terso/ Format</a><a class=\"\n                      block px-3 py-1.5 rounded text-sm no-underline transition-colors\n                      text-[#8a8a96] hover:text-[#e8e6e3] hover:bg-[#141418]\n                    \" href=\"/docs/agent-integration\">Agent Integration</a></div><div class=\"mb-6\"><p class=\"text-[11px] font-semibold text-[#55555e] uppercase tracking-wider px-3 mb-2 font-mono\">Modes</p><a class=\"\n                      block px-3 py-1.5 rounded text-sm no-underline transition-colors\n                      text-indigo-400 bg-indigo-500/10\n                    \" href=\"/docs/standalone-vs-connected\">Standalone vs Connected</a></div></div><div class=\"mt-8 pt-4 border-t border-[#222228] px-3\"><a href=\"https://github.com/petr-kin/terso\" target=\"_blank\" rel=\"noopener\" class=\"text-xs text-[#55555e] hover:text-[#8a8a96] no-underline transition-colors\">GitHub</a></div></aside><main class=\"flex-1 min-w-0 px-6 lg:px-12 py-10 lg:py-12 max-w-3xl\"><article><div class=\"prose prose-invert\"><h1 id=\"standalone-vs-connected-mode\">Standalone vs Connected Mode</h1>\n<p>Terso works in two modes: standalone (offline, no account) and connected (synced with Omnus).</p>\n<h2 id=\"standalone-mode\">Standalone mode</h2>\n<p>No Omnus account needed. Free, open-source, works offline.</p>\n<pre><code class=\"hljs language-bash\">terso init\nterso capture <span class=\"hljs-string\">&quot;switched auth to Supabase&quot;</span>\nterso compile\n</code></pre>\n<p>What works:</p>\n<ul>\n<li>Local capture to <code>.terso/local/captures.jsonl</code></li>\n<li>Offline compilation into structured Markdown</li>\n<li>Secret scanning (regex-based, runs locally)</li>\n<li>File output to <code>.terso/generated/</code></li>\n</ul>\n<p>What&#x27;s missing:</p>\n<ul>\n<li>No LLM-powered classification</li>\n<li>No cross-project search</li>\n<li>No portfolio monitoring</li>\n<li>No state consolidation</li>\n</ul>\n<h2 id=\"connected-mode\">Connected mode</h2>\n<p>Link to an Omnus account for the full pipeline.</p>\n<pre><code class=\"hljs language-bash\">terso login\nterso <span class=\"hljs-built_in\">sync</span>\n</code></pre>\n<p>What&#x27;s added:</p>\n<ul>\n<li>LLM classification (Gemini Flash + Claude Sonnet)</li>\n<li>Cross-project knowledge search</li>\n<li>Shared operational knowledge</li>\n<li>Nightly state consolidation</li>\n<li>Review queue for uncertain items</li>\n<li>Portfolio health monitoring</li>\n</ul>\n<h2 id=\"configuration\">Configuration</h2>\n<p>Check connection status:</p>\n<pre><code class=\"hljs language-bash\">terso doctor\n</code></pre>\n<p>Force standalone mode in <code>.terso/config.json</code>:</p>\n<pre><code class=\"hljs language-json\"><span class=\"hljs-punctuation\">{</span>\n  <span class=\"hljs-attr\">&quot;omnus&quot;</span><span class=\"hljs-punctuation\">:</span> <span class=\"hljs-punctuation\">{</span>\n    <span class=\"hljs-attr\">&quot;endpoint&quot;</span><span class=\"hljs-punctuation\">:</span> <span class=\"hljs-string\">&quot;https://api.omnus.dev&quot;</span><span class=\"hljs-punctuation\">,</span>\n    <span class=\"hljs-attr\">&quot;connected&quot;</span><span class=\"hljs-punctuation\">:</span> <span class=\"hljs-literal\"><span class=\"hljs-keyword\">false</span></span>\n  <span class=\"hljs-punctuation\">}</span>\n<span class=\"hljs-punctuation\">}</span>\n</code></pre></div><div class=\"mt-16 pt-8 border-t border-[#27272A] flex justify-between gap-4\"><a class=\"group text-left no-underline\" href=\"/docs/agent-integration\"><span class=\"text-[11px] font-medium text-[#52525B] uppercase tracking-wider font-mono\">Previous</span><span class=\"block text-sm font-medium text-[#A1A1AA] group-hover:text-[#6366F1] mt-1\">← <!-- -->Agent Integration</span></a><div></div></div></article><!--$--><!--/$--></main></div></div><script src=\"/_next/static/chunks/08127cfdc8ec19e0.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[39756,[\\\"/_next/static/chunks/ff1a16fafef87110.js\\\",\\\"/_next/static/chunks/d2be314c3ece3fbe.js\\\"],\\\"default\\\"]\\n3:I[37457,[\\\"/_next/static/chunks/ff1a16fafef87110.js\\\",\\\"/_next/static/chunks/d2be314c3ece3fbe.js\\\"],\\\"default\\\"]\\n4:I[96801,[\\\"/_next/static/chunks/799da3d0ae0b5b88.js\\\"],\\\"NavBar\\\"]\\n5:I[65205,[\\\"/_next/static/chunks/799da3d0ae0b5b88.js\\\"],\\\"default\\\"]\\n7:I[97367,[\\\"/_next/static/chunks/ff1a16fafef87110.js\\\",\\\"/_next/static/chunks/d2be314c3ece3fbe.js\\\"],\\\"OutletBoundary\\\"]\\n8:\\\"$Sreact.suspense\\\"\\na:I[97367,[\\\"/_next/static/chunks/ff1a16fafef87110.js\\\",\\\"/_next/static/chunks/d2be314c3ece3fbe.js\\\"],\\\"ViewportBoundary\\\"]\\nc:I[97367,[\\\"/_next/static/chunks/ff1a16fafef87110.js\\\",\\\"/_next/static/chunks/d2be314c3ece3fbe.js\\\"],\\\"MetadataBoundary\\\"]\\ne:I[68027,[],\\\"default\\\"]\\n:HL[\\\"/_next/static/chunks/12a43aaab7140da3.css\\\",\\\"style\\\"]\\n:HL[\\\"https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@