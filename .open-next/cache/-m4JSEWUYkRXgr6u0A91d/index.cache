m into structured Markdown that Cursor and Claude Code read natively.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex gap-2.5 justify-center mt-6 sm:mt-7 flex-wrap opacity-0 animate-fade-up\\\",\\\"style\\\":{\\\"animationDelay\\\":\\\"0.5s\\\"},\\\"children\\\":[[\\\"$\\\",\\\"$L5\\\",null,{\\\"text\\\":\\\"npm i -g terso\\\"}],[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"/docs\\\",\\\"className\\\":\\\"px-5 py-3 rounded-[10px] border border-[#2e2e36] text-[#8a8a96] text-sm font-semibold no-underline min-h-[44px] flex items-center hover:border-[#55555e] hover:text-[#e8e6e3] transition-colors\\\",\\\"children\\\":\\\"Read the docs\\\"}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[13px] text-[#55555e] mt-3.5 opacity-0 animate-fade-up\\\",\\\"style\\\":{\\\"animationDelay\\\":\\\"0.55s\\\"},\\\"children\\\":\\\"Open source · MIT · No account needed\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex gap-2.5 sm:gap-4 justify-center flex-wrap mt-[18px] sm:mt-[22px] opacity-0 animate-fade-up\\\",\\\"style\\\":{\\\"animationDelay\\\":\\\"0.6s\\\"},\\\"children\\\":[[\\\"$\\\",\\\"span\\\",\\\"Cursor\\\",{\\\"className\\\":\\\"text-xs font-medium text-[#55555e] tracking-wide\\\",\\\"children\\\":\\\"Cursor\\\"}],\\\"$L6\\\",\\\"$L7\\\",\\\"$L8\\\"]}]]}],\\\"$L9\\\",\\\"$La\\\",\\\"$Lb\\\",\\\"$Lc\\\",\\\"$Ld\\\",\\\"$Le\\\"]}],\\\"$Lf\\\"]}],[\\\"$L10\\\"],\\\"$L11\\\"]}],{},null,false,false]},null,false,false],\\\"$L12\\\",false]],\\\"m\\\":\\\"$undefined\\\",\\\"G\\\":[\\\"$13\\\",[]],\\\"S\\\":true}\\n\"])</script><script>self.__next_f.push([1,\"14:I[30038,[\\\"/_next/static/chunks/49c4eba19aa57842.js\\\"],\\\"Terminal\\\"]\\n15:I[37827,[\\\"/_next/static/chunks/49c4eba19aa57842.js\\\"],\\\"Reveal\\\"]\\n19:I[57000,[\\\"/_next/static/chunks/49c4eba19aa57842.js\\\"],\\\"AnimatedPipeline\\\"]\\n1c:I[97367,[\\\"/_next/static/chunks/ff1a16fafef87110.js\\\",\\\"/_next/static/chunks/d2be314c3ece3fbe.js\\\"],\\\"OutletBoundary\\\"]\\n1d:\\\